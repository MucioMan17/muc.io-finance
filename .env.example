# Copy this file to ".env" and fill in your real values.
# The .env file is git-ignored — your secrets never get committed.

# --- AI brain (the writer/curator) ---
# Default provider is OpenRouter (one key, many models, easy to swap).
# 1. Get a key at https://openrouter.ai/keys  (free to create)
# 2. Add a little credit at Settings -> Credits (prepaid; you can't be over-charged).
#    Or, to test for $0, browse https://openrouter.ai/models, pick a model whose id
#    ends in ":free", and use that as LLM_MODEL below.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
# IMPORTANT: copy the EXACT model id from https://openrouter.ai/models
# (the value below is only an example and may need updating).
LLM_MODEL=anthropic/claude-sonnet-4.6
# Leave LLM_API_KEY blank to run in "dry" mode (templated scripts, no cost).

# --- Telegram cockpit ---
# Create a bot with @BotFather in Telegram, paste the token here.
TELEGRAM_BOT_TOKEN=
# Your own Telegram user/chat id (get it from @userinfobot) so the bot
# only ever talks to you.
TELEGRAM_CHAT_ID=

# --- B-roll footage behind the captions (optional but recommended) ---
# Free key at https://www.pexels.com/api/ — put real stock video behind each video.
# Leave blank to fall back to the plain gradient background.
PEXELS_API_KEY=

# --- YouTube (optional until you're ready to publish) ---
# Path to the OAuth client secrets JSON you download from Google Cloud.
YOUTUBE_CLIENT_SECRETS=secrets/youtube_client_secret.json
